includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    
    level: 7

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        - '#Return type of call to method Illuminate\\Support\\Collection.*contains unresolvable type\.#'

    parallel:
        maximumNumberOfProcesses: 1